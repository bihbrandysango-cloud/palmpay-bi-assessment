    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "What the two panels show",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold",
                      "color": "#2D2A3A"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The United States (right) fell as far as ",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  },
                  {
                    "value": "45.9% below the previous year in January 2009",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", and stayed more than 24% down every month until August 2009.",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Germany (left) barely moved: its worst months were ",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  },
                  {
                    "value": "-9.8% in November 2008",
                    "textStyle": {
                      "fontSize": "13pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " and -8.2% in January 2009, and it was back near the previous year's level by March 2009.",
                    "textStyle": {
                      "fontSize": "13pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Figures exclude Silicon Valley Bikes.",
                    "textStyle": {
                      "fontSize": "10pt",
                      "color": "#8A84A3"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
