table Sales
	lineageTag: eed7b79c-d3da-44a8-89c7-4b5bd3973d71

	measure 'Total Sales Revenue' = SUM(Sales[Revenue USD])
		lineageTag: c1aac00a-8d1f-43ee-8129-0a58a2e40421

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Revenue PY' = CALCULATE(Sales[Total Sales Revenue], SAMEPERIODLASTYEAR(DateTable[Date]))
		lineageTag: 8975349f-965b-4c3a-b662-9de1fb649e11

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales % Change YOY' = DIVIDE([Total Sales Revenue] - [Sales Revenue PY],[Sales Revenue PY])
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 3b2b6ca5-6557-4a1e-9947-6a969ca98e5c

	measure TotalQuantity = SUM(Sales[SalesQuantity])
		formatString: 0
		lineageTag: ac76b618-acc6-4e42-a465-e7639330e635

	measure MinQuantityPerYear = CALCULATE(MINX(VALUES(Sales[Product]), [TotalQuantity]), ALLEXCEPT(Sales, Sales[Year]))
		formatString: 0
		lineageTag: 943ab7fa-8090-4bf7-9ad5-30104d870f23

	measure TotalRevenue = SUM(Sales[Revenue])
		lineageTag: 5891ca53-595b-49b3-810f-ba2b39699d94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotalSales2011 = ```
			CALCULATE([TotalQuantity], Sales[Year] = 2011)
			
			```
		formatString: 0
		lineageTag: 9c8e66ce-252e-4c07-b704-87d09bf59380

	measure SalesPctByCity = ```
			
			DIVIDE(
			    CALCULATE([TotalQuantity], Sales[Year] = 2011),
			    CALCULATE([TotalQuantity], ALL(Sales[City]), Sales[Year] = 2011),
			    0
			)
			
			```
		lineageTag: 9da166de-af8f-4883-9467-c26dc7d4e06c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure AverageSalesPct = ```
			
			AVERAGEX(
			    VALUES(Sales[City]),
			    CALCULATE([SalesPctByCity], Sales[Year] = 2011)
			)
			
			```
		lineageTag: 86104f21-4853-49fa-a092-83fe7961cabf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure DiffFromAverage = ```
			[SalesPctByCity] - [AverageSalesPct]
			
			```
		lineageTag: 5396eb3c-46c5-4df7-892b-a825ea99b9ae

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Revenue (USD)' = SUM(Sales[Revenue USD])
