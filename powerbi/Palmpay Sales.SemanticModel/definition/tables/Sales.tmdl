	measure 'Revenue Bar (City)' =
			VAR _v = [Revenue (USD)]
			VAR _max = MAXX ( ALLSELECTED ( Sales[City] ), [Revenue (USD)] )
			VAR _w = 150
			VAR _len = IF ( _max = 0, 0, ROUND ( DIVIDE ( _v, _max ) * _w, 0 ) )
			RETURN
			    IF (
			        ISINSCOPE ( Sales[City] ) && NOT ISBLANK ( _v ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='22'>"
			            & "<rect x='0' y='5' width='" & _w & "' height='12' rx='6' fill='%23E9DDFB'/>"
			            & "<rect x='0' y='5' width='" & _len & "' height='12' rx='6' fill='%237031C5'/>"
			            & "</svg>"
			    )
		displayFolder: Table Bars
		lineageTag: 866c9dd4-c812-42e0-80e2-f87ce6513ecb
		dataCategory: ImageUrl

	measure 'Revenue Bar (Product)' =
			VAR _v = [Revenue (USD)]
			VAR _max = MAXX ( ALLSELECTED ( Sales[ProductDescr] ), [Revenue (USD)] )
			VAR _w = 150
			VAR _len = IF ( _max = 0, 0, ROUND ( DIVIDE ( _v, _max ) * _w, 0 ) )
			RETURN
			    IF (
			        ISINSCOPE ( Sales[ProductDescr] ) && NOT ISBLANK ( _v ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='22'>"
			            & "<rect x='0' y='5' width='" & _w & "' height='12' rx='6' fill='%23E9DDFB'/>"
			            & "<rect x='0' y='5' width='" & _len & "' height='12' rx='6' fill='%237031C5'/>"
			            & "</svg>"
			    )
		displayFolder: Table Bars
		lineageTag: 1c1e273b-a3f8-4fad-8b42-2ab87cb6a7d1
		dataCategory: ImageUrl

	measure 'Margin Bar (City)' =
			VAR _m = [Gross Margin %]
			VAR _w = 100
			VAR _len = ROUND ( MIN ( MAX ( _m, 0 ), 1 ) * _w, 0 )
			RETURN
			    IF (
			        ISINSCOPE ( Sales[City] ) && NOT ISBLANK ( _m ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22'>"
			            & "<rect x='0' y='5' width='" & _w & "' height='12' rx='6' fill='%23E9DDFB'/>"
			            & "<rect x='0' y='5' width='" & _len & "' height='12' rx='6' fill='%23EC5A96'/>"
			            & "<text x='" & ( _w + 6 ) & "' y='16' font-family='Segoe UI' font-size='11' font-weight='bold' fill='%232D2A3A'>" & FORMAT ( _m * 100, "0.0" ) & "%25</text>"
			            & "</svg>"
			    )
		displayFolder: Table Bars
		lineageTag: 4e7aab7f-4e0b-44f7-ad72-65b93794aafb
		dataCategory: ImageUrl

	measure 'Margin Bar (Product)' =
			VAR _m = [Gross Margin %]
			VAR _w = 100
			VAR _len = ROUND ( MIN ( MAX ( _m, 0 ), 1 ) * _w, 0 )
			RETURN
			    IF (
			        ISINSCOPE ( Sales[ProductDescr] ) && NOT ISBLANK ( _m ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='150' height='22'>"
			            & "<rect x='0' y='5' width='" & _w & "' height='12' rx='6' fill='%23E9DDFB'/>"
			            & "<rect x='0' y='5' width='" & _len & "' height='12' rx='6' fill='%23EC5A96'/>"
			            & "<text x='" & ( _w + 6 ) & "' y='16' font-family='Segoe UI' font-size='11' font-weight='bold' fill='%232D2A3A'>" & FORMAT ( _m * 100, "0.0" ) & "%25</text>"
			            & "</svg>"
			    )
		displayFolder: Table Bars
		lineageTag: ad7d4870-0793-4aa3-a1f7-f78d39286009
		dataCategory: ImageUrl

	measure 'Off-road Share of Bikes' = DIVIDE ( CALCULATE ( [TotalQuantity], Sales[Product Category] = "ORB" ), CALCULATE ( [TotalQuantity], Sales[Product Category] <> "ACC" ) )
		formatString: 0.0%
		displayFolder: Assessment B3
		lineageTag: e010c222-2ca5-456e-bd08-46d94fea1fbb

	measure 'Avg City Off-road Share' = AVERAGEX ( FILTER ( ALL ( Sales[City] ), CALCULATE ( [TotalQuantity], Sales[Product Category] <> "ACC" ) > 0 ), [Off-road Share of Bikes] )
		formatString: 0.0%
		displayFolder: Assessment B3
		lineageTag: 2736f4e4-6ece-4df9-94e3-2cd8c211e278

