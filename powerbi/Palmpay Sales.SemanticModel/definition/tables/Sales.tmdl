		displayFolder: Modern KPIs
		lineageTag: 2edc4241-b051-4235-a100-180e3b37162e

	measure 'Gross Profit (USD)' = SUM(Sales[Revenue USD]) - SUM(Sales[Cogm USD])
		formatString: "$"#,0
		displayFolder: Modern KPIs
		lineageTag: 87434ce2-e8be-4197-8d9c-b3beb1b58f9f

	measure 'Gross Margin %' = DIVIDE([Gross Profit (USD)], [Revenue (USD)])
		formatString: 0.0%;-0.0%;0.0%
		displayFolder: Modern KPIs
		lineageTag: e8f9520d-dfbd-4199-a22c-2d5c85f37804

	measure 'Revenue Sparkline' =
			VAR _last = MAX ( Sales[Date] )
			VAR _start = DATE ( YEAR ( _last ), MONTH ( _last ) - 11, 1 )
			VAR _w = 240
			VAR _h = 34
			VAR _months =
			    ADDCOLUMNS (
			        GENERATESERIES ( 0, 11, 1 ),
			        "@v",
			            VAR _s = EDATE ( _start, [Value] )
			            VAR _e = EOMONTH ( _s, 0 )
			            RETURN
			                CALCULATE (
			                    [Revenue (USD)],
			                    REMOVEFILTERS ( Sales[Date], Sales[YEAR], Sales[MONTH], Sales[DAY] ),
			                    Sales[Date] >= _s,
			                    Sales[Date] <= _e
			                ) + 0
			    )
			VAR _min = MINX ( _months, [@v] )
			VAR _max = MAXX ( _months, [@v] )
			VAR _pts =
			    CONCATENATEX (
			        _months,
			        FORMAT ( 4 + [Value] * ( _w - 8 ) / 11, "0" ) & ","
			            & FORMAT ( _h - 6 - DIVIDE ( [@v] - _min, _max - _min ) * ( _h - 12 ), "0" ),
			        " ",
			        [Value], ASC
			    )
			VAR _lastY = FORMAT ( _h - 6 - DIVIDE ( MAXX ( FILTER ( _months, [Value] = 11 ), [@v] ) - _min, _max - _min ) * ( _h - 12 ), "0" )
			RETURN
			    IF (
			        NOT ISBLANK ( _last ),
			        "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='" & _w & "' height='" & _h & "'>"
			            & "<polygon points='4," & _h & " " & _pts & " " & ( _w - 4 ) & "," & _h & "' fill='%237031C5' fill-opacity='0.12'/>"
			            & "<polyline points='" & _pts & "' fill='none' stroke='%237031C5' stroke-width='2.5' stroke-linejoin='round' stroke-linecap='round'/>"
			            & "<circle cx='" & ( _w - 4 ) & "' cy='" & _lastY & "' r='3.5' fill='%23EC5A96'/>"
			            & "</svg>"
			    )
		displayFolder: Modern KPIs
		lineageTag: 0fa874db-4dc2-4480-9242-4a72399dfdc6
		dataCategory: ImageUrl

	measure 'Gross Profit Sparkline' =
			VAR _last = MAX ( Sales[Date] )
