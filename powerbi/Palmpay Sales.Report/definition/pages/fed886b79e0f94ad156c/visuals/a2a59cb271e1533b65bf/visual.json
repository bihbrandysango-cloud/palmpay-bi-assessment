                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Palmpay sells bicycles, bike parts and accessories in two markets, the United States and Germany. This report reviews five years of sales, from January 2007 to December 2011.",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "It asks four questions:",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How did revenue and units sold change from year to year?",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "How did the 2008 financial crisis affect each country?",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Which products and cities earn the most, and which sell the least?",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "When do customers buy?",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Over the period, revenue was ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  },
                  {
                    "value": "$285M",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": ", gross profit was ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  },
                  {
                    "value": "$149M",
                    "textStyle": {
                      "fontSize": "14pt",
                      "fontWeight": "bold"
                    }
                  },
                  {
                    "value": " and the gross margin was ",
                    "textStyle": {
                      "fontSize": "14pt"
                    }
                  },
                  {
                    "value": "52.3%",
